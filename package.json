{
  "name": "monitoring-dashboard",
  "version": "1.0.0",
  "description": "A lightweight, self-hosted server monitoring dashboard built with Fastify and React.",
  "main": "index.js",
  "scripts": {
    "build": "cd client && npm run build",
    "start": "node index.js",
    "dev": "concurrently \"cd client && npm run dev\" \"node --watch index.js\"",
    "postinstall": "cd client && npm install"
  },
  "keywords": [
    "monitoring",
    "dashboard",
    "docker",
    "fastify",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
