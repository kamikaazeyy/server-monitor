PORT=3000
# Bind address. 127.0.0.1 is the safe default — only change to 0.0.0.0
# if you understand the exposure (or are behind a trusted proxy/VPN).
HOST=127.0.0.1

# Auth is account-based: the first visitor creates the login on the
# signup screen (credentials are stored hashed in .auth.json).
# Set this to true ONLY when the app sits behind external auth
# (Cloudflare Access, Authentik, VPN-only network, etc.)
# MONITOR_AUTH_DISABLED=false
# AUTH_FILE=/custom/path/.auth.json

# GitHub repo shown in the GitHub / CI tab (requires `gh` CLI auth)
MONITOR_REPO=owner/repo

# EAS / app builds (optional feature)
EXPO_TOKEN=your_expo_access_token_here
FITSO_MOBILE_DIR=/path/to/your/mobile-app
BUILDS_DIR=/opt/monitoring-builds
BUILDS_KEEP=10

# Database browser
DB_READONLY=true
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT=600000

# Terminal limits
TERMINAL_MAX_SESSIONS=10
TERMINAL_MAX_PER_IP=3
