PORT=3000
HOST=0.0.0.0
MONITOR_REPO=kamikaazeyy/fitso

# EAS / Fitso builds
EXPO_TOKEN=your_expo_access_token_here
FITSO_MOBILE_DIR=/home/kamikaazeyy/fitso/mobile
BUILDS_DIR=/opt/monitoring-builds
BUILDS_KEEP=10

# Database browser
DB_READONLY=true
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT=600000

# Env / secrets manager (AES-256-GCM encrypted at rest)
# ENV_STORE_FILE=/opt/monitoring-dashboard/.envstore.json
# ENV_STORE_KEY_FILE=/opt/monitoring-dashboard/.envstore.key
# Colon-separated roots scanned for .env files (env manager "Server .env files")
# ENV_SCAN_DIRS=/home/kamikaazeyy:/opt:/srv:/var/www
