{
  "name": "monitoring-dashboard",
  "version": "1.0.0",
  "description": "A lightweight, self-hosted server monitoring dashboard built with Express, Socket.io, React and node-pty.",
  "main": "index.js",
  "scripts": {
    "build": "cd client && npm run build",
    "start": "node index.js",
    "dev": "concurrently \"cd client && npm run dev\" \"node --watch index.js\""
  },
  "keywords": [
    "monitoring",
    "dashboard",
    "docker",
    "express",
    "socket.io",
    "node-pty",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "node-pty": "^1.0.0",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
