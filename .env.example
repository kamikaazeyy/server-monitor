PORT=3000
HOST=0.0.0.0
MONITOR_REPO=kamikaazeyy/fitso

# Auth — required for API, sockets, and the terminal. If unset, a random
# token is generated at startup and printed to the console.
DASHBOARD_TOKEN=

# EAS / Fitso builds
EXPO_TOKEN=your_expo_access_token_here
FITSO_MOBILE_DIR=/home/kamikaazeyy/fitso/mobile
BUILDS_DIR=/opt/monitoring-builds
BUILDS_KEEP=10

# Database browser
DB_READONLY=true
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT=600000
